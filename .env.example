# Copia este archivo como .env antes de ejecutar docker compose.
# --- backend ---
CENZI_ENV=local
CENZI_LOG_LEVEL=INFO
# Deja vacío para usar el umbral elegido en validación (guardado con el modelo)
CENZI_UMBRAL=
CENZI_MAX_CARACTERES=500
CENZI_MAX_LOTE=50
# Orígenes permitidos para llamar la API directo desde un navegador (coma separada)
CENZI_CORS_ORIGINS=http://localhost:8080
WEB_CONCURRENCY=2
# --- puertos publicados en tu máquina ---
API_PORT=8000
WEB_PORT=8080
